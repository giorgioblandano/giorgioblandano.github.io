---
import Base from '../layouts/Base.astro';
import PubItem from '../components/PubItem.astro';
import pubs from '../data/publications.json';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const navUrl = (p: string) => `${base}${p.startsWith('/') ? p : `/${p}`}`;
const selected = pubs as any[];
const interests = ['Geometric deep learning', 'Equivariant architectures', 'Vision-language models', 'Embodied agents', 'Egocentric video', '3D representations'];
const news = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 4);
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const ord = (n: number) => { const s = ['th', 'st', 'nd', 'rd'], v = n % 100; return s[(v - 20) % 10] || s[v] || s[0]; };
const fmt = (d: Date) => `${d.getDate()}${ord(d.getDate())} ${MONTHS[d.getMonth()]} ${d.getFullYear()}`;

const stroke = (d: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const fill = (d: string) => `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">${d}</svg>`;
const ico = {
  mail: stroke('<rect x="2.5" y="4.5" width="19" height="15" rx="2.5"/><path d="m3 7 9 6 9-6"/>'),
  pin: stroke('<path d="M19.5 10c0 5.5-7.5 11.5-7.5 11.5S4.5 15.5 4.5 10a7.5 7.5 0 0 1 15 0z"/><circle cx="12" cy="10" r="2.6"/>'),
  globe: stroke('<circle cx="12" cy="12" r="9.5"/><path d="M2.5 12h19"/><path d="M12 2.5a14.5 14.5 0 0 1 0 19 14.5 14.5 0 0 1 0-19z"/>'),
  scholar: fill('<path d="M5.242 13.769 0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z"/>'),
  linkedin: fill('<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.064 2.064 0 1 1 0-4.128 2.064 2.064 0 0 1 0 4.128zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>'),
  github: fill('<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.755-1.335-1.755-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>'),
};
const contacts = [
  { label: 'Google Scholar', value: 'Giorgio Blandano', href: 'https://scholar.google.com/citations?user=e7ZoyhwAAAAJ', icon: ico.scholar },
  { label: 'LinkedIn', value: 'giorgio-blandano', href: 'https://www.linkedin.com/in/giorgio-blandano-b56150372/', icon: ico.linkedin },
  { label: 'Office', value: 'PHuSe Lab · via Celoria 18, Milano', href: 'https://maps.google.com/?q=via+Celoria+18+Milano', icon: ico.pin },
  { label: 'PHuSe Lab', value: 'phuselab.di.unimi.it', href: 'http://phuselab.di.unimi.it', icon: ico.globe },
  { label: 'PHuSe Lab GitHub', value: 'github.com/phuselab', href: 'https://github.com/phuselab', icon: ico.github },
];
const copyIco = stroke('<rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>');
---

<Base title="Giorgio Blandano — UniMi">
  <section class="hero">
    <div class="hero-grid">
      <div>
        <div style="display:flex;gap:20px;align-items:center;flex-wrap:wrap">
          <img src={navUrl('/images/profile.png')} alt="Giorgio Blandano" style="width:160px;height:160px;border-radius:18px;object-fit:cover;object-position:center 30%;border:3px solid #fff;outline:1px solid var(--border);box-shadow:var(--shadow);background:linear-gradient(135deg,#d5ece6,#f1f8f6);flex-shrink:0" />
          <div>
            <h1 class="h1" style="margin:0 0 12px;line-height:1.02">Giorgio Blandano</h1>
            <div class="pill"><span class="pill-dot"></span> 3rd Year PhD Candidate · UniMi</div>
          </div>
        </div>
        <p class="muted" style="margin:12px 0 0;font-size:1.02rem">Dipartimento di Informatica “Giovanni Degli Antoni” — Università degli Studi di Milano. Member of <a href="http://phuselab.di.unimi.it" target="_blank" rel="noopener">PHuSe Lab</a>.</p>
        <div class="prose" style="margin-top:16px">
          <p>I am a 3rd year PhD candidate at the University of Milan and a member of the PHuSe Lab, advised by <a href="https://lanzarotti.di.unimi.it" target="_blank" rel="noopener">Raffaella Lanzarotti</a> and <a href="https://aledamelio.github.io/website/" target="_blank" rel="noopener">Alessandro D'Amelio</a>.</p>
          <p>I am broadly interested in geometric deep learning, equivariant architectures, and vision-language models. My current work focuses on enabling embodied agents to reason over long egocentric experiences, through the integration of spatial grounding, temporal context, and persistent 3D representations.</p>
        </div>
      </div>

      <div class="card" id="news" style="align-self:start">
        <h2 class="h2" style="margin:0">Latest news</h2>
        <div style="margin-top:8px">
          {news.map(async n => {
            const { Content } = await n.render();
            const [type, venue] = n.data.tags ?? [];
            return (
              <div class="news-item">
                <div class="news-date">{fmt(n.data.date)}</div>
                <div class="news-label">{venue}{type ? ` · ${type[0].toUpperCase() + type.slice(1)}` : ''}</div>
                <div class="news-body"><Content /></div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <section style="margin-top:18px;display:flex;gap:8px;align-items:center;flex-wrap:wrap">
    <div class="kicker" style="flex-basis:100%">Research Interests</div>
    {interests.map(i => <span class="tag">{i}</span>)}
  </section>

  <section id="contacts" style="margin-top:18px">
    <div class="kicker" style="margin-bottom:10px">Contacts</div>
    <div class="contact-grid">
      <div class="contact-tile ct-primary">
        <span class="ct-ico" set:html={ico.mail} />
        <span class="ct-text">
          <span class="ct-label">Email</span>
          <a class="ct-value ct-mail" href="mailto:giorgio.blandano@unimi.it">giorgio.blandano@unimi.it</a>
        </span>
        <button class="ct-copy" type="button" data-copy="giorgio.blandano@unimi.it" aria-label="Copy email address" title="Copy email address"><span class="ct-copy-ico" set:html={copyIco} /><span class="ct-copy-ico ct-check" set:html={stroke('<path d="M20 6 9 17l-5-5"/>')} /></button>
      </div>
      {contacts.map(c => (
        <a class="contact-tile" href={c.href} target={c.href.startsWith('mailto') ? undefined : '_blank'} rel="noopener">
          <span class="ct-ico" set:html={c.icon} />
          <span class="ct-text">
            <span class="ct-label">{c.label}</span>
            <span class="ct-value">{c.value}</span>
          </span>
          <span class="ct-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section id="research" style="margin-top:18px">
    <div style="display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin-bottom:10px">
      <h2 class="h2" style="margin:0">Research</h2>
      <a href="https://scholar.google.com/citations?user=e7ZoyhwAAAAJ" target="_blank" rel="noopener" style="font-size:0.9rem;font-weight:600">Google Scholar →</a>
    </div>
    <div class="card">
      {selected.map(p => <PubItem p={p} />)}
    </div>
  </section>
</Base>

<style is:global>
  .btn-ico { display: inline-grid; width: 15px; height: 15px; }
  .btn-ico svg { width: 100%; height: 100%; }
  .btn.secondary .btn-ico { color: var(--accent); }
  .contact-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  @media (max-width: 900px) { .contact-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .contact-grid { grid-template-columns: 1fr; } }
  .contact-tile { display: flex; align-items: center; gap: 14px; padding: 14px 16px; background: white; border: 1px solid var(--border); border-radius: 14px; color: var(--fg); transition: border-color .18s, box-shadow .18s, transform .18s; min-width: 0; }
  .contact-tile:hover { text-decoration: none; border-color: var(--accent); box-shadow: var(--shadow-hover); transform: translateY(-1px); }
  .ct-ico { width: 40px; height: 40px; border-radius: 11px; display: grid; place-items: center; background: var(--accent); color: white; flex-shrink: 0; }
  .ct-ico svg { width: 19px; height: 19px; }
  .ct-text { display: flex; flex-direction: column; min-width: 0; flex: 1; }
  .ct-label { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); line-height: 1.3; }
  .ct-value { font-weight: 600; font-size: 0.92rem; line-height: 1.4; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ct-arrow { color: var(--muted2); font-size: 0.9rem; transition: color .18s, transform .18s; }
  .contact-tile:hover .ct-arrow { color: var(--accent); transform: translate(2px, -2px); }
</style>

<style is:global>
  @media (min-width: 881px) {
    .hero-grid { grid-template-columns: 1fr 1.2fr; gap: 40px; }
    .hero-grid > #news { order: -1; }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.ct-copy').forEach(btn => {
    btn.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(btn.dataset.copy || ''); }
      catch { window.location.href = `mailto:${btn.dataset.copy}`; return; }
      btn.classList.add('done'); btn.title = 'Copied!';
      setTimeout(() => { btn.classList.remove('done'); btn.title = 'Copy email address'; }, 1600);
    });
  });
</script>

<style is:global>
  .contact-tile.ct-primary:hover { transform: none; box-shadow: none; border-color: var(--border); }
  .ct-mail { color: var(--fg); }
  .ct-mail:hover { color: var(--accent); }
  .ct-copy { display: grid; place-items: center; width: 34px; height: 34px; flex-shrink: 0; color: var(--accent); background: white; border: 1px solid #cfe9e3; border-radius: 9px; padding: 0; cursor: pointer; transition: background .15s, color .15s, border-color .15s; }
  .ct-copy:hover { border-color: var(--accent); }
  .ct-copy.done { background: var(--accent); border-color: var(--accent); color: white; }
  .ct-copy-ico { display: grid; width: 15px; height: 15px; }
  .ct-check, .ct-copy.done .ct-copy-ico:not(.ct-check) { display: none; }
  .ct-copy.done .ct-check { display: grid; }
  .ct-copy-ico svg { width: 100%; height: 100%; }
</style>
