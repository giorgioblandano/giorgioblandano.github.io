---
interface Props { p: any; }
const { p } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const authorsHtml = p.authors.replace(/G\. Blandano/g, '<strong>G. Blandano</strong>');
const statusClass = p.status === 'Under review' ? 'badge-review' : 'badge-status';
---
<div class="pub pub-row">
  {p.image && <img class="pub-thumb" src={`${base}/images/${p.image}`} alt="" loading="lazy" />}
  <div>
    <div class="pub-title">
      {p.url ? <a href={p.url} target="_blank" rel="noopener">{p.title}</a> : p.title}
      <span class="muted" style="font-weight:400"> ({p.year})</span>
    </div>
    <div class="pub-meta" set:html={`${authorsHtml} · <em>${p.venue}</em>`} />
    <div style="margin-top:8px;display:flex;gap:6px;flex-wrap:wrap;align-items:center">
      <span class="badge badge-accent">{p.short} · {p.type}</span>
      {p.status && <span class={`badge ${statusClass}`}>{p.status}</span>}
      {p.url ? <a class="badge" href={p.url} target="_blank" rel="noopener">Paper</a> : <span class="badge">Coming soon</span>}
      {p.note && <span class="muted" style="font-size:0.84rem">{p.note}</span>}
    </div>
  </div>
</div>
